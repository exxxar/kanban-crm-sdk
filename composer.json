{
    "name": "exxxar/kanban-sdk",
    "description": "PHP SDK для работы с KanbanCRM API",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Exxxar",
            "email": "exxxar@email.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "guzzlehttp/guzzle": "^7.0",
        "illuminate/support": "^10.0|^11.0",
        "nesbot/carbon": "^2.0|^3.0"
    },
    "autoload": {
        "psr-4": {
            "Exxxar\\Kanban\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Exxxar\\Kanban\\KanbanServiceProvider"
            ],
            "aliases": {
                "Kanban": "Exxxar\\Kanban\\Facades\\Kanban"
            }
        }
    }
}